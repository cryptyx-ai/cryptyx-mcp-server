{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cryptyx-ai/cryptyx-mcp-server",
  "description": "CRYPTYX — Digital Asset Intelligence. Institutional-grade quant intelligence for digital assets.",
  "websiteUrl": "https://cryptyx.ai/docs/mcp",
  "repository": {
    "url": "https://github.com/cryptyx-ai/cryptyx-mcp-server",
    "source": "github"
  },
  "version": "0.12.3",
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.cryptyx.ai/api/mcp"
    }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@cryptyx/mcp-server",
      "version": "0.12.3",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "CRYPTYX API key (cx_...). Create one at https://cryptyx.ai/account",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "CRYPTYX_API_KEY"
        },
        {
          "description": "Override API base URL (default: https://cryptyx.ai)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "CRYPTYX_API_URL"
        }
      ]
    }
  ]
}
