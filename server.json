{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.cryptyx-ai/cryptyx-mcp-server",
  "description": "Institutional crypto intelligence for agents. 30 tools: signals, backtests, regime, triggers.",
  "repository": {
    "url": "https://github.com/cryptyx-ai/cryptyx",
    "source": "github"
  },
  "version": "0.8.0",
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@cryptyx/mcp-server",
      "version": "0.8.0",
      "transport": {
        "type": "stdio"
      },
      "environmentVariables": [
        {
          "description": "CRYPTYX API key — get one at https://cryptyx.ai",
          "isRequired": true,
          "format": "string",
          "isSecret": true,
          "name": "CRYPTYX_API_KEY"
        },
        {
          "description": "Override API base URL (default: https://cryptyx.ai)",
          "isRequired": false,
          "format": "string",
          "isSecret": false,
          "name": "CRYPTYX_API_URL"
        }
      ]
    }
  ]
}
